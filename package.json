{
  "name": "ticket-triage-system",
  "version": "1.0.0",
  "description": "Deterministic, auditable AI support-triage pipeline. Code owns every decision; the model drafts prose.",
  "license": "ISC",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
